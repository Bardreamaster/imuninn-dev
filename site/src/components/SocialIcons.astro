---
// Header: a "Docs" link before the social icons (Starlight has no top-nav setting).
import Default from "@astrojs/starlight/components/SocialIcons.astro";
const lang = Astro.locals.starlightRoute?.lang ?? "zh-CN";
const en = lang.startsWith("en");
const links = [
  { label: en ? "Docs" : "文档", href: en ? "/en/start/overview/" : "/start/overview/" },
  { label: en ? "Python" : "Python 包", href: en ? "/en/python/quickstart/" : "/python/quickstart/" },
  { label: en ? "Web viewer" : "Web 查看器", href: "http://imuninn-webviewer.projects.weijinqi.com" },
];
---
<nav class="top-links" aria-label={en ? "Sections" : "栏目"}>
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>
<Default />
<style>
  .top-links { display: flex; gap: 1rem; align-items: center; margin-inline-end: 0.75rem; }
  .top-links a { color: var(--sl-color-gray-2); text-decoration: none; font-size: var(--sl-text-sm); font-weight: 500; white-space: nowrap; }
  .top-links a:hover { color: var(--sl-color-white); }
  @media (max-width: 50rem) { .top-links { display: none; } }
</style>
