---
// Header: wordmark and the Docs link on the left, search and the controls on the right.
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
const lang = Astro.locals.starlightRoute?.lang ?? "zh-CN";
const en = lang.startsWith("en");
const docs = { label: en ? "Docs" : "文档", href: en ? "/en/start/overview/" : "/start/overview/" };
---
<div class="header">
  <div class="left-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
    <nav class="top-links sl-flex" aria-label={en ? "Sections" : "栏目"}>
      <a href={docs.href}>{docs.label}</a>
    </nav>
  </div>
  <div class="search-slot"><Search /></div>
  <div class="sl-flex right-group">
    <div class="sl-hidden md:sl-flex social-icons"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  /* Three columns like Starlight's own header: [title + links] [search] [controls]. Everything
     may shrink (min-width: 0); the search box takes the free width up to a cap; links hide on
     small screens and the social icons follow Starlight's md breakpoint. */
  .header { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--sl-nav-gap); align-items: center; height: 100%; min-width: 0; }
  .title-wrapper { overflow: clip; padding: 0.25rem; margin: -0.25rem; min-width: 0; }
  .top-links { gap: 1.25rem; align-items: center; margin-inline-start: 0.5rem; min-width: 0; }
  .top-links a { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--sl-color-gray-2); text-decoration: none; font-size: var(--sl-text-sm); font-weight: 500; white-space: nowrap; }
  .top-links a:hover { color: var(--sl-color-white); }
  .left-group { display: flex; align-items: center; gap: var(--sl-nav-gap); min-width: 0; }
  .search-slot { justify-self: end; width: 100%; max-width: 22rem; min-width: 0; }
  .right-group, .social-icons { gap: 1rem; align-items: center; min-width: 0; }
  .social-icons::after { content: ""; height: 2rem; border-inline-end: 1px solid var(--sl-color-gray-5); }
  @media (max-width: 50rem) { .top-links { display: none; } }
</style>
